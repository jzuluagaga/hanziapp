<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_generate" targetNamespace="https://hanziapp.co/bpmn" exporter="HanziApp docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_generate">
    <bpmn:participant id="Pool_generate" name="HanziApp · Content generation (one batch)" processRef="Proc_generate" />
    <bpmn:participant id="Pool_llm" name="Language model (Claude Batch API)" />
    <bpmn:messageFlow id="Msg_generate_0" name="Words and official glosses" sourceRef="T3_submit" targetRef="Pool_llm" />
    <bpmn:messageFlow id="Msg_generate_1" name="Senses, examples, translations" sourceRef="Pool_llm" targetRef="M3_results" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_generate" name="HanziApp · Content generation (one batch)" isExecutable="false">
    <bpmn:documentation>An administrator generates draft content for up to 100 words in one language with the language model, then reviews every draft. Nothing generated is visible to users before approval (RN-14).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_generate">
      <bpmn:lane id="L3_admin" name="Administrator">
        <bpmn:flowNodeRef>S3_need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP3_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_app" name="HanziApp">
        <bpmn:flowNodeRef>T3_batch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3_any</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3_none</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M3_results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S3_need" name="Content needed for a level and language">
      <bpmn:outgoing>Flow_generate_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T3_select" name="Select up to 100 words and the language">
      <bpmn:incoming>Flow_generate_0</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T3_batch" name="Create the batch without words already approved">
      <bpmn:incoming>Flow_generate_1</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3_any" name="Any words to generate?">
      <bpmn:incoming>Flow_generate_2</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_generate_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3_none" name="Nothing to generate">
      <bpmn:incoming>Flow_generate_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T3_submit" name="Submit the batch">
      <bpmn:incoming>Flow_generate_4</bpmn:incoming>
      <bpmn:incoming>Flow_generate_10</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="M3_results" name="Results returned">
      <bpmn:incoming>Flow_generate_5</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_M3_results" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T3_store" name="Save the drafts and mark the failed words">
      <bpmn:incoming>Flow_generate_6</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T3_validate" name="Run the four automatic validations">
      <bpmn:incoming>Flow_generate_7</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3_failed" name="Any failed words?">
      <bpmn:incoming>Flow_generate_8</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_generate_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3_retry" name="Retry the failed words">
      <bpmn:incoming>Flow_generate_9</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP3_review" name="Review each draft">
      <bpmn:incoming>Flow_generate_11</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_12</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:subProcess>
    <bpmn:endEvent id="E3_done" name="Batch reviewed">
      <bpmn:incoming>Flow_generate_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_generate_0" sourceRef="S3_need" targetRef="T3_select" />
    <bpmn:sequenceFlow id="Flow_generate_1" sourceRef="T3_select" targetRef="T3_batch" />
    <bpmn:sequenceFlow id="Flow_generate_2" sourceRef="T3_batch" targetRef="G3_any" />
    <bpmn:sequenceFlow id="Flow_generate_3" name="no" sourceRef="G3_any" targetRef="E3_none" />
    <bpmn:sequenceFlow id="Flow_generate_4" name="yes" sourceRef="G3_any" targetRef="T3_submit" />
    <bpmn:sequenceFlow id="Flow_generate_5" sourceRef="T3_submit" targetRef="M3_results" />
    <bpmn:sequenceFlow id="Flow_generate_6" sourceRef="M3_results" targetRef="T3_store" />
    <bpmn:sequenceFlow id="Flow_generate_7" sourceRef="T3_store" targetRef="T3_validate" />
    <bpmn:sequenceFlow id="Flow_generate_8" sourceRef="T3_validate" targetRef="G3_failed" />
    <bpmn:sequenceFlow id="Flow_generate_9" name="yes" sourceRef="G3_failed" targetRef="T3_retry" />
    <bpmn:sequenceFlow id="Flow_generate_10" sourceRef="T3_retry" targetRef="T3_submit" />
    <bpmn:sequenceFlow id="Flow_generate_11" name="no" sourceRef="G3_failed" targetRef="SP3_review" />
    <bpmn:sequenceFlow id="Flow_generate_12" sourceRef="SP3_review" targetRef="E3_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_generate">
    <bpmndi:BPMNPlane id="Plane_generate" bpmnElement="Collab_generate">
      <bpmndi:BPMNShape id="Pool_generate_di" bpmnElement="Pool_generate" isHorizontal="true"><dc:Bounds x="0" y="0" width="1714" height="400" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_admin_di" bpmnElement="L3_admin" isHorizontal="true"><dc:Bounds x="30" y="0" width="1684" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_app_di" bpmnElement="L3_app" isHorizontal="true"><dc:Bounds x="30" y="150" width="1684" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_llm_di" bpmnElement="Pool_llm" isHorizontal="true"><dc:Bounds x="0" y="440" width="1714" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S3_need_di" bpmnElement="S3_need"><dc:Bounds x="96" y="57" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="64" y="97" width="100" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_select_di" bpmnElement="T3_select"><dc:Bounds x="176" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_batch_di" bpmnElement="T3_batch"><dc:Bounds x="360" y="183" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_any_di" bpmnElement="G3_any"><dc:Bounds x="544" y="200" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="521" y="166" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_none_di" bpmnElement="E3_none"><dc:Bounds x="551" y="307" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="519" y="347" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_submit_di" bpmnElement="T3_submit"><dc:Bounds x="638" y="183" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M3_results_di" bpmnElement="M3_results"><dc:Bounds x="822" y="207" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="790" y="173" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_store_di" bpmnElement="T3_store"><dc:Bounds x="902" y="183" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_validate_di" bpmnElement="T3_validate"><dc:Bounds x="1086" y="183" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_failed_di" bpmnElement="G3_failed"><dc:Bounds x="1315" y="200" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1292" y="254" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_retry_di" bpmnElement="T3_retry"><dc:Bounds x="1270" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP3_review_di" bpmnElement="SP3_review" isExpanded="false"><dc:Bounds x="1454" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_done_di" bpmnElement="E3_done"><dc:Bounds x="1638" y="57" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1606" y="97" width="100" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_generate_0_di" bpmnElement="Flow_generate_0"><di:waypoint x="132" y="75" /><di:waypoint x="176" y="75" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_1_di" bpmnElement="Flow_generate_1"><di:waypoint x="316" y="75" /><di:waypoint x="430" y="75" /><di:waypoint x="430" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_2_di" bpmnElement="Flow_generate_2"><di:waypoint x="500" y="225" /><di:waypoint x="544" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_3_di" bpmnElement="Flow_generate_3"><di:waypoint x="569" y="250" /><di:waypoint x="569" y="307" /><bpmndi:BPMNLabel><dc:Bounds x="574" y="254" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_4_di" bpmnElement="Flow_generate_4"><di:waypoint x="594" y="225" /><di:waypoint x="638" y="225" /><bpmndi:BPMNLabel><dc:Bounds x="602" y="206" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_5_di" bpmnElement="Flow_generate_5"><di:waypoint x="778" y="225" /><di:waypoint x="822" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_6_di" bpmnElement="Flow_generate_6"><di:waypoint x="858" y="225" /><di:waypoint x="902" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_7_di" bpmnElement="Flow_generate_7"><di:waypoint x="1042" y="225" /><di:waypoint x="1086" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_8_di" bpmnElement="Flow_generate_8"><di:waypoint x="1226" y="225" /><di:waypoint x="1315" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_9_di" bpmnElement="Flow_generate_9"><di:waypoint x="1340" y="200" /><di:waypoint x="1340" y="117" /><bpmndi:BPMNLabel><dc:Bounds x="1345" y="180" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_10_di" bpmnElement="Flow_generate_10"><di:waypoint x="1270" y="75" /><di:waypoint x="708" y="75" /><di:waypoint x="708" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_11_di" bpmnElement="Flow_generate_11"><di:waypoint x="1365" y="225" /><di:waypoint x="1524" y="225" /><di:waypoint x="1524" y="117" /><bpmndi:BPMNLabel><dc:Bounds x="1373" y="206" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_12_di" bpmnElement="Flow_generate_12"><di:waypoint x="1594" y="75" /><di:waypoint x="1638" y="75" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_generate_0_di" bpmnElement="Msg_generate_0"><di:waypoint x="708" y="267" /><di:waypoint x="708" y="440" /><bpmndi:BPMNLabel><dc:Bounds x="714" y="332" width="90" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Msg_generate_1_di" bpmnElement="Msg_generate_1"><di:waypoint x="840" y="440" /><di:waypoint x="840" y="243" /><bpmndi:BPMNLabel><dc:Bounds x="846" y="320" width="90" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>