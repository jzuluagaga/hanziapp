<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_study" targetNamespace="https://hanziapp.co/bpmn" exporter="HanziApp docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_study">
    <bpmn:participant id="Pool_study" name="HanziApp · Study session" processRef="Proc_study" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_study" name="HanziApp · Study session" isExecutable="false">
    <bpmn:documentation>Top-level study session: start or resume a session on a deck, work through its queue, and close it by recording the active day, the streak and any badge.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_study">
      <bpmn:lane id="L1_student" name="Student">
        <bpmn:flowNodeRef>S1_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP1_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1_leave</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_app" name="HanziApp">
        <bpmn:flowNodeRef>G1_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_not_started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_progress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_resume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_nothing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_paused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_streak</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_badge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_badge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1_join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1_summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1_open" name="Student opens a deck">
      <bpmn:outgoing>Flow_study_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1_choose" name="Choose the scope and the practice type">
      <bpmn:incoming>Flow_study_0</bpmn:incoming>
      <bpmn:outgoing>Flow_study_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1_empty" name="Deck empty?">
      <bpmn:incoming>Flow_study_1</bpmn:incoming>
      <bpmn:outgoing>Flow_study_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_study_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1_not_started" name="Session not started">
      <bpmn:incoming>Flow_study_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G1_progress" name="Session already in progress?">
      <bpmn:incoming>Flow_study_3</bpmn:incoming>
      <bpmn:outgoing>Flow_study_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_study_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T1_resume" name="Resume at the saved position">
      <bpmn:incoming>Flow_study_4</bpmn:incoming>
      <bpmn:outgoing>Flow_study_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T1_build" name="Build the session queue">
      <bpmn:incoming>Flow_study_5</bpmn:incoming>
      <bpmn:outgoing>Flow_study_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1_queue" name="Queue empty?">
      <bpmn:incoming>Flow_study_6</bpmn:incoming>
      <bpmn:outgoing>Flow_study_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_study_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1_nothing" name="Nothing to study today">
      <bpmn:incoming>Flow_study_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G1_join" name="">
      <bpmn:incoming>Flow_study_8</bpmn:incoming>
      <bpmn:incoming>Flow_study_9</bpmn:incoming>
      <bpmn:outgoing>Flow_study_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP1_queue" name="Work through the queue">
      <bpmn:incoming>Flow_study_10</bpmn:incoming>
      <bpmn:outgoing>Flow_study_11</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B1_leave" name="Student leaves the session" attachedToRef="SP1_queue" cancelActivity="true">
      <bpmn:outgoing>Flow_study_12</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_B1_leave"><bpmn:condition xsi:type="bpmn:tFormalExpression">Student leaves the session</bpmn:condition></bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T1_keep" name="Keep the session in progress at its position">
      <bpmn:incoming>Flow_study_12</bpmn:incoming>
      <bpmn:outgoing>Flow_study_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1_paused" name="Session paused">
      <bpmn:incoming>Flow_study_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T1_streak" name="Record the active day and update the streak">
      <bpmn:incoming>Flow_study_11</bpmn:incoming>
      <bpmn:outgoing>Flow_study_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1_badge" name="New milestone reached?">
      <bpmn:incoming>Flow_study_14</bpmn:incoming>
      <bpmn:outgoing>Flow_study_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_study_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T1_badge" name="Award the badge">
      <bpmn:incoming>Flow_study_15</bpmn:incoming>
      <bpmn:outgoing>Flow_study_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1_join2" name="">
      <bpmn:incoming>Flow_study_16</bpmn:incoming>
      <bpmn:incoming>Flow_study_17</bpmn:incoming>
      <bpmn:outgoing>Flow_study_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T1_summary" name="Show the session summary">
      <bpmn:incoming>Flow_study_18</bpmn:incoming>
      <bpmn:outgoing>Flow_study_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1_done" name="Session completed">
      <bpmn:incoming>Flow_study_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_study_0" sourceRef="S1_open" targetRef="T1_choose" />
    <bpmn:sequenceFlow id="Flow_study_1" sourceRef="T1_choose" targetRef="G1_empty" />
    <bpmn:sequenceFlow id="Flow_study_2" name="yes" sourceRef="G1_empty" targetRef="E1_not_started" />
    <bpmn:sequenceFlow id="Flow_study_3" name="no" sourceRef="G1_empty" targetRef="G1_progress" />
    <bpmn:sequenceFlow id="Flow_study_4" name="yes" sourceRef="G1_progress" targetRef="T1_resume" />
    <bpmn:sequenceFlow id="Flow_study_5" name="no" sourceRef="G1_progress" targetRef="T1_build" />
    <bpmn:sequenceFlow id="Flow_study_6" sourceRef="T1_build" targetRef="G1_queue" />
    <bpmn:sequenceFlow id="Flow_study_7" name="yes" sourceRef="G1_queue" targetRef="E1_nothing" />
    <bpmn:sequenceFlow id="Flow_study_8" name="no" sourceRef="G1_queue" targetRef="G1_join" />
    <bpmn:sequenceFlow id="Flow_study_9" sourceRef="T1_resume" targetRef="G1_join" />
    <bpmn:sequenceFlow id="Flow_study_10" sourceRef="G1_join" targetRef="SP1_queue" />
    <bpmn:sequenceFlow id="Flow_study_11" sourceRef="SP1_queue" targetRef="T1_streak" />
    <bpmn:sequenceFlow id="Flow_study_12" sourceRef="B1_leave" targetRef="T1_keep" />
    <bpmn:sequenceFlow id="Flow_study_13" sourceRef="T1_keep" targetRef="E1_paused" />
    <bpmn:sequenceFlow id="Flow_study_14" sourceRef="T1_streak" targetRef="G1_badge" />
    <bpmn:sequenceFlow id="Flow_study_15" name="yes" sourceRef="G1_badge" targetRef="T1_badge" />
    <bpmn:sequenceFlow id="Flow_study_16" name="no" sourceRef="G1_badge" targetRef="G1_join2" />
    <bpmn:sequenceFlow id="Flow_study_17" sourceRef="T1_badge" targetRef="G1_join2" />
    <bpmn:sequenceFlow id="Flow_study_18" sourceRef="G1_join2" targetRef="T1_summary" />
    <bpmn:sequenceFlow id="Flow_study_19" sourceRef="T1_summary" targetRef="E1_done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_study">
    <bpmndi:BPMNPlane id="Plane_study" bpmnElement="Collab_study">
      <bpmndi:BPMNShape id="Pool_study_di" bpmnElement="Pool_study" isHorizontal="true"><dc:Bounds x="0" y="0" width="1886" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_student_di" bpmnElement="L1_student" isHorizontal="true"><dc:Bounds x="30" y="0" width="1856" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_app_di" bpmnElement="L1_app" isHorizontal="true"><dc:Bounds x="30" y="150" width="1856" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_open_di" bpmnElement="S1_open"><dc:Bounds x="96" y="57" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="64" y="97" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_choose_di" bpmnElement="T1_choose"><dc:Bounds x="176" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_empty_di" bpmnElement="G1_empty"><dc:Bounds x="360" y="210" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="287" y="182" width="96" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_not_started_di" bpmnElement="E1_not_started"><dc:Bounds x="367" y="317" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="335" y="357" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_progress_di" bpmnElement="G1_progress"><dc:Bounds x="454" y="210" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="431" y="162" width="96" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_resume_di" bpmnElement="T1_resume"><dc:Bounds x="548" y="193" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_build_di" bpmnElement="T1_build"><dc:Bounds x="548" y="293" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_queue_di" bpmnElement="G1_queue"><dc:Bounds x="732" y="310" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="786" y="327" width="96" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_nothing_di" bpmnElement="E1_nothing"><dc:Bounds x="739" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="781" y="405" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_join_di" bpmnElement="G1_join"><dc:Bounds x="732" y="210" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP1_queue_di" bpmnElement="SP1_queue" isExpanded="false"><dc:Bounds x="886" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B1_leave_di" bpmnElement="B1_leave"><dc:Bounds x="938" y="99" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="978" y="121" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_keep_di" bpmnElement="T1_keep"><dc:Bounds x="886" y="293" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_paused_di" bpmnElement="E1_paused"><dc:Bounds x="1122" y="317" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1090" y="357" width="100" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_streak_di" bpmnElement="T1_streak"><dc:Bounds x="1070" y="193" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_badge_di" bpmnElement="G1_badge"><dc:Bounds x="1254" y="210" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1231" y="176" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_badge_di" bpmnElement="T1_badge"><dc:Bounds x="1348" y="293" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_join2_di" bpmnElement="G1_join2"><dc:Bounds x="1532" y="210" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_summary_di" bpmnElement="T1_summary"><dc:Bounds x="1626" y="193" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_done_di" bpmnElement="E1_done"><dc:Bounds x="1810" y="217" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1778" y="257" width="100" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_study_0_di" bpmnElement="Flow_study_0"><di:waypoint x="132" y="75" /><di:waypoint x="176" y="75" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_1_di" bpmnElement="Flow_study_1"><di:waypoint x="316" y="75" /><di:waypoint x="385" y="75" /><di:waypoint x="385" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_2_di" bpmnElement="Flow_study_2"><di:waypoint x="385" y="260" /><di:waypoint x="385" y="317" /><bpmndi:BPMNLabel><dc:Bounds x="390" y="264" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_3_di" bpmnElement="Flow_study_3"><di:waypoint x="410" y="235" /><di:waypoint x="454" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="418" y="216" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_4_di" bpmnElement="Flow_study_4"><di:waypoint x="504" y="235" /><di:waypoint x="548" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="512" y="216" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_5_di" bpmnElement="Flow_study_5"><di:waypoint x="479" y="260" /><di:waypoint x="479" y="335" /><di:waypoint x="548" y="335" /><bpmndi:BPMNLabel><dc:Bounds x="484" y="264" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_6_di" bpmnElement="Flow_study_6"><di:waypoint x="688" y="335" /><di:waypoint x="732" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_7_di" bpmnElement="Flow_study_7"><di:waypoint x="757" y="360" /><di:waypoint x="757" y="402" /><bpmndi:BPMNLabel><dc:Bounds x="762" y="364" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_8_di" bpmnElement="Flow_study_8"><di:waypoint x="757" y="310" /><di:waypoint x="757" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="762" y="290" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_9_di" bpmnElement="Flow_study_9"><di:waypoint x="688" y="235" /><di:waypoint x="732" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_10_di" bpmnElement="Flow_study_10"><di:waypoint x="757" y="210" /><di:waypoint x="757" y="75" /><di:waypoint x="886" y="75" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_11_di" bpmnElement="Flow_study_11"><di:waypoint x="1026" y="75" /><di:waypoint x="1140" y="75" /><di:waypoint x="1140" y="193" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_12_di" bpmnElement="Flow_study_12"><di:waypoint x="956" y="135" /><di:waypoint x="956" y="293" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_13_di" bpmnElement="Flow_study_13"><di:waypoint x="1026" y="335" /><di:waypoint x="1122" y="335" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_14_di" bpmnElement="Flow_study_14"><di:waypoint x="1210" y="235" /><di:waypoint x="1254" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_15_di" bpmnElement="Flow_study_15"><di:waypoint x="1279" y="260" /><di:waypoint x="1279" y="335" /><di:waypoint x="1348" y="335" /><bpmndi:BPMNLabel><dc:Bounds x="1284" y="264" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_16_di" bpmnElement="Flow_study_16"><di:waypoint x="1304" y="235" /><di:waypoint x="1532" y="235" /><bpmndi:BPMNLabel><dc:Bounds x="1312" y="216" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_17_di" bpmnElement="Flow_study_17"><di:waypoint x="1488" y="335" /><di:waypoint x="1557" y="335" /><di:waypoint x="1557" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_18_di" bpmnElement="Flow_study_18"><di:waypoint x="1582" y="235" /><di:waypoint x="1626" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_study_19_di" bpmnElement="Flow_study_19"><di:waypoint x="1766" y="235" /><di:waypoint x="1810" y="235" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>