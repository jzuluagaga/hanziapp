<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_queue" targetNamespace="https://hanziapp.co/bpmn" exporter="HanziApp docs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_queue">
    <bpmn:participant id="Pool_queue" name="HanziApp · Work through the queue (sub-process of Figure 1)" processRef="Proc_queue" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_queue" name="HanziApp · Work through the queue (sub-process of Figure 1)" isExecutable="false">
    <bpmn:documentation>One pass over the session queue. Each word goes through the flashcard step (practice type flashcards or both) and then the writing step for each of its characters (practice type writing or both).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_queue">
      <bpmn:lane id="L2_student" name="Student">
        <bpmn:flowNodeRef>T2_recall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_grade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_app" name="HanziApp">
        <bpmn:flowNodeRef>S2_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_flash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_hard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_requeue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_joinA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2_wsave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_chars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_joinB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2_left</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2_done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S2_ready" name="Queue ready">
      <bpmn:outgoing>Flow_queue_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T2_show" name="Show the next word's hanzi">
      <bpmn:incoming>Flow_queue_0</bpmn:incoming>
      <bpmn:incoming>Flow_queue_19</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2_flash" name="Flashcard step?">
      <bpmn:incoming>Flow_queue_1</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_queue_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2_recall" name="Recall it, then reveal the answer">
      <bpmn:incoming>Flow_queue_2</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2_grade" name="Grade it Easy or Hard">
      <bpmn:incoming>Flow_queue_3</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2_save" name="Save the grade and update the FSRS state">
      <bpmn:incoming>Flow_queue_4</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2_hard" name="Graded Hard?">
      <bpmn:incoming>Flow_queue_5</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_queue_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T2_requeue" name="Requeue it 3 cards later, or drop it after the third Hard">
      <bpmn:incoming>Flow_queue_6</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2_joinA" name="">
      <bpmn:incoming>Flow_queue_7</bpmn:incoming>
      <bpmn:incoming>Flow_queue_8</bpmn:incoming>
      <bpmn:incoming>Flow_queue_9</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2_write" name="Writing step?">
      <bpmn:incoming>Flow_queue_10</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_queue_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2_write" name="Write the next character">
      <bpmn:incoming>Flow_queue_11</bpmn:incoming>
      <bpmn:incoming>Flow_queue_14</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2_wsave" name="Save the result and update the writing state">
      <bpmn:incoming>Flow_queue_12</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2_chars" name="More characters in the word?">
      <bpmn:incoming>Flow_queue_13</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_queue_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2_joinB" name="">
      <bpmn:incoming>Flow_queue_15</bpmn:incoming>
      <bpmn:incoming>Flow_queue_16</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2_left" name="Words left in the queue?">
      <bpmn:incoming>Flow_queue_17</bpmn:incoming>
      <bpmn:outgoing>Flow_queue_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_queue_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2_done" name="Queue finished">
      <bpmn:incoming>Flow_queue_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_queue_0" sourceRef="S2_ready" targetRef="T2_show" />
    <bpmn:sequenceFlow id="Flow_queue_1" sourceRef="T2_show" targetRef="G2_flash" />
    <bpmn:sequenceFlow id="Flow_queue_2" name="yes" sourceRef="G2_flash" targetRef="T2_recall" />
    <bpmn:sequenceFlow id="Flow_queue_3" sourceRef="T2_recall" targetRef="T2_grade" />
    <bpmn:sequenceFlow id="Flow_queue_4" sourceRef="T2_grade" targetRef="T2_save" />
    <bpmn:sequenceFlow id="Flow_queue_5" sourceRef="T2_save" targetRef="G2_hard" />
    <bpmn:sequenceFlow id="Flow_queue_6" name="yes" sourceRef="G2_hard" targetRef="T2_requeue" />
    <bpmn:sequenceFlow id="Flow_queue_7" name="no" sourceRef="G2_hard" targetRef="G2_joinA" />
    <bpmn:sequenceFlow id="Flow_queue_8" sourceRef="T2_requeue" targetRef="G2_joinA" />
    <bpmn:sequenceFlow id="Flow_queue_9" name="no" sourceRef="G2_flash" targetRef="G2_joinA" />
    <bpmn:sequenceFlow id="Flow_queue_10" sourceRef="G2_joinA" targetRef="G2_write" />
    <bpmn:sequenceFlow id="Flow_queue_11" name="yes" sourceRef="G2_write" targetRef="T2_write" />
    <bpmn:sequenceFlow id="Flow_queue_12" sourceRef="T2_write" targetRef="T2_wsave" />
    <bpmn:sequenceFlow id="Flow_queue_13" sourceRef="T2_wsave" targetRef="G2_chars" />
    <bpmn:sequenceFlow id="Flow_queue_14" name="yes" sourceRef="G2_chars" targetRef="T2_write" />
    <bpmn:sequenceFlow id="Flow_queue_15" name="no" sourceRef="G2_chars" targetRef="G2_joinB" />
    <bpmn:sequenceFlow id="Flow_queue_16" name="no" sourceRef="G2_write" targetRef="G2_joinB" />
    <bpmn:sequenceFlow id="Flow_queue_17" sourceRef="G2_joinB" targetRef="G2_left" />
    <bpmn:sequenceFlow id="Flow_queue_18" name="no" sourceRef="G2_left" targetRef="E2_done" />
    <bpmn:sequenceFlow id="Flow_queue_19" name="yes" sourceRef="G2_left" targetRef="T2_show" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_queue">
    <bpmndi:BPMNPlane id="Plane_queue" bpmnElement="Collab_queue">
      <bpmndi:BPMNShape id="Pool_queue_di" bpmnElement="Pool_queue" isHorizontal="true"><dc:Bounds x="0" y="0" width="1920" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_student_di" bpmnElement="L2_student" isHorizontal="true"><dc:Bounds x="30" y="0" width="1890" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_app_di" bpmnElement="L2_app" isHorizontal="true"><dc:Bounds x="30" y="150" width="1890" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2_ready_di" bpmnElement="S2_ready"><dc:Bounds x="96" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="64" y="262" width="100" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_show_di" bpmnElement="T2_show"><dc:Bounds x="176" y="198" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_flash_di" bpmnElement="G2_flash"><dc:Bounds x="390" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="317" y="173" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_recall_di" bpmnElement="T2_recall"><dc:Bounds x="484" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_grade_di" bpmnElement="T2_grade"><dc:Bounds x="668" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_save_di" bpmnElement="T2_save"><dc:Bounds x="668" y="198" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_hard_di" bpmnElement="G2_hard"><dc:Bounds x="852" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="829" y="195" width="96" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_requeue_di" bpmnElement="T2_requeue"><dc:Bounds x="946" y="288" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_joinA_di" bpmnElement="G2_joinA"><dc:Bounds x="1130" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_write_di" bpmnElement="G2_write"><dc:Bounds x="1284" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1211" y="187" width="96" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_write_di" bpmnElement="T2_write"><dc:Bounds x="1378" y="33" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_wsave_di" bpmnElement="T2_wsave"><dc:Bounds x="1378" y="198" width="140" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_chars_di" bpmnElement="G2_chars"><dc:Bounds x="1562" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1539" y="269" width="96" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_joinB_di" bpmnElement="G2_joinB"><dc:Bounds x="1656" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_left_di" bpmnElement="G2_left"><dc:Bounds x="1750" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1727" y="181" width="96" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_done_di" bpmnElement="E2_done"><dc:Bounds x="1844" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1812" y="262" width="100" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_queue_0_di" bpmnElement="Flow_queue_0"><di:waypoint x="132" y="240" /><di:waypoint x="176" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_1_di" bpmnElement="Flow_queue_1"><di:waypoint x="316" y="240" /><di:waypoint x="390" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_2_di" bpmnElement="Flow_queue_2"><di:waypoint x="415" y="215" /><di:waypoint x="415" y="75" /><di:waypoint x="484" y="75" /><bpmndi:BPMNLabel><dc:Bounds x="420" y="195" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_3_di" bpmnElement="Flow_queue_3"><di:waypoint x="624" y="75" /><di:waypoint x="668" y="75" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_4_di" bpmnElement="Flow_queue_4"><di:waypoint x="738" y="117" /><di:waypoint x="738" y="198" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_5_di" bpmnElement="Flow_queue_5"><di:waypoint x="808" y="240" /><di:waypoint x="852" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_6_di" bpmnElement="Flow_queue_6"><di:waypoint x="877" y="265" /><di:waypoint x="877" y="330" /><di:waypoint x="946" y="330" /><bpmndi:BPMNLabel><dc:Bounds x="882" y="269" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_7_di" bpmnElement="Flow_queue_7"><di:waypoint x="902" y="240" /><di:waypoint x="1130" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="910" y="221" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_8_di" bpmnElement="Flow_queue_8"><di:waypoint x="1086" y="330" /><di:waypoint x="1155" y="330" /><di:waypoint x="1155" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_9_di" bpmnElement="Flow_queue_9"><di:waypoint x="415" y="265" /><di:waypoint x="415" y="395" /><di:waypoint x="1155" y="395" /><di:waypoint x="1155" y="265" /><bpmndi:BPMNLabel><dc:Bounds x="420" y="269" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_10_di" bpmnElement="Flow_queue_10"><di:waypoint x="1180" y="240" /><di:waypoint x="1284" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_11_di" bpmnElement="Flow_queue_11"><di:waypoint x="1309" y="215" /><di:waypoint x="1309" y="75" /><di:waypoint x="1378" y="75" /><bpmndi:BPMNLabel><dc:Bounds x="1314" y="195" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_12_di" bpmnElement="Flow_queue_12"><di:waypoint x="1448" y="117" /><di:waypoint x="1448" y="198" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_13_di" bpmnElement="Flow_queue_13"><di:waypoint x="1518" y="240" /><di:waypoint x="1562" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_14_di" bpmnElement="Flow_queue_14"><di:waypoint x="1587" y="215" /><di:waypoint x="1587" y="14" /><di:waypoint x="1448" y="14" /><di:waypoint x="1448" y="33" /><bpmndi:BPMNLabel><dc:Bounds x="1592" y="195" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_15_di" bpmnElement="Flow_queue_15"><di:waypoint x="1612" y="240" /><di:waypoint x="1656" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="1620" y="221" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_16_di" bpmnElement="Flow_queue_16"><di:waypoint x="1309" y="265" /><di:waypoint x="1309" y="395" /><di:waypoint x="1681" y="395" /><di:waypoint x="1681" y="265" /><bpmndi:BPMNLabel><dc:Bounds x="1314" y="269" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_17_di" bpmnElement="Flow_queue_17"><di:waypoint x="1706" y="240" /><di:waypoint x="1750" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_18_di" bpmnElement="Flow_queue_18"><di:waypoint x="1800" y="240" /><di:waypoint x="1844" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="1808" y="221" width="18" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_queue_19_di" bpmnElement="Flow_queue_19"><di:waypoint x="1775" y="265" /><di:waypoint x="1775" y="450" /><di:waypoint x="246" y="450" /><di:waypoint x="246" y="282" /><bpmndi:BPMNLabel><dc:Bounds x="1780" y="269" width="24" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>